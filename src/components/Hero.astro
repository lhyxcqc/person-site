---
import { site } from '../data/site';
const base = site.siteBase;
---
<section id="top" class="bg-gradient-to-br from-slate-900 via-slate-800 to-brand-700 text-white">
  <div class="mx-auto max-w-5xl px-6 py-24 sm:py-32">
    <p class="text-sm font-medium uppercase tracking-widest text-brand-200">{site.location} · {site.title}</p>
    <h1 class="mt-4 text-4xl font-bold sm:text-6xl">{site.name}</h1>
    <p class="mt-6 max-w-2xl text-lg text-slate-200">{site.tagline}</p>

    <div class="mt-8 flex flex-wrap gap-2">
      {site.skills.flatMap((g) => g.items).slice(0, 8).map((s) => (
        <span class="rounded-full bg-white/10 px-3 py-1 text-sm text-slate-100">{s}</span>
      ))}
    </div>

    <div class="mt-10 flex flex-wrap gap-4">
      <a
        href={`${base}/resume.pdf`}
        class="rounded-lg bg-brand-500 px-5 py-2.5 font-medium text-white transition hover:bg-brand-600"
      >下载简历</a>
    </div>
  </div>
</section>
