---
import type { SkillGroup } from '../data/site';
interface Props {
  skills: SkillGroup[];
}
const { skills } = Astro.props;
---
<section id="skills" class="border-t border-slate-200 bg-white">
  <div class="mx-auto max-w-5xl px-6 py-20">
    <h2 class="text-2xl font-bold text-slate-900 sm:text-3xl">技能栈</h2>
    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {skills.map((g) => (
        <div class="rounded-xl border border-slate-200 p-5">
          <h3 class="text-sm font-semibold uppercase tracking-wide text-brand-600">{g.category}</h3>
          <div class="mt-3 flex flex-wrap gap-2">
            {g.items.map((s) => (
              <span class="rounded bg-slate-100 px-2.5 py-1 text-sm text-slate-700">{s}</span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
