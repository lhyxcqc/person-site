---
import type { CollectionEntry } from 'astro:content';
interface Props {
  projects: CollectionEntry<'projects'>[];
}
const { projects } = Astro.props;
---
<section id="projects" class="mx-auto max-w-5xl px-6 py-20">
  <h2 class="text-2xl font-bold text-slate-900 sm:text-3xl">精选项目</h2>
  <div class="mt-10 grid gap-6 md:grid-cols-2">
    {projects.map((p) => (
      <article class="flex flex-col rounded-xl border border-slate-200 bg-white p-6 transition hover:shadow-lg">
        <div class="flex items-start justify-between gap-3">
          <h3 class="text-lg font-semibold text-slate-900">{p.data.title}</h3>
          <span class="shrink-0 rounded bg-brand-50 px-2 py-0.5 text-xs font-medium text-brand-700">{p.data.role}</span>
        </div>
        <p class="mt-2 text-sm text-slate-600">{p.data.summary}</p>

        <div class="mt-4 space-y-3 text-sm">
          <p><span class="font-medium text-slate-700">挑战：</span><span class="text-slate-600">{p.data.challenge}</span></p>
          <p><span class="font-medium text-slate-700">方案：</span><span class="text-slate-600">{p.data.solution}</span></p>
          <p><span class="font-medium text-slate-700">结果：</span><span class="text-slate-600">{p.data.result}</span></p>
        </div>

        <div class="mt-4 flex flex-wrap gap-2">
          {p.data.tags.map((t) => (
            <span class="rounded-full bg-slate-100 px-2 py-0.5 text-xs text-slate-500">{t}</span>
          ))}
        </div>
        <div class="mt-3 flex flex-wrap gap-2">
          {p.data.stack.map((s) => (
            <span class="rounded bg-brand-50 px-2 py-0.5 text-xs text-brand-700">{s}</span>
          ))}
        </div>
      </article>
    ))}
  </div>
</section>
