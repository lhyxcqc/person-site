---
import type { CollectionEntry } from 'astro:content';
interface Props {
  experiences: CollectionEntry<'experiences'>[];
}
const { experiences } = Astro.props;
---
<section id="experience" class="border-t border-slate-200 bg-white">
  <div class="mx-auto max-w-5xl px-6 py-20">
    <h2 class="text-2xl font-bold text-slate-900 sm:text-3xl">工作经历</h2>
    <ol class="mt-10 space-y-10 border-l-2 border-slate-200 pl-6">
      {experiences.map((exp) => (
        <li class="relative">
          <span class="absolute -left-[31px] top-1.5 h-3 w-3 rounded-full bg-brand-600 ring-4 ring-white"></span>
          <div class="flex flex-wrap items-baseline justify-between gap-2">
            <h3 class="text-lg font-semibold text-slate-900">{exp.data.company}</h3>
            <span class="text-sm text-slate-400">{exp.data.period}</span>
          </div>
          <p class="mt-1 text-sm font-medium text-brand-600">{exp.data.role}</p>
          <p class="mt-3 text-slate-600">{exp.data.summary}</p>
          <ul class="mt-3 space-y-1.5">
            {exp.data.highlights.map((h) => (
              <li class="flex gap-2 text-sm text-slate-600">
                <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-brand-400"></span>
                <span>{h}</span>
              </li>
            ))}
          </ul>
          {exp.data.stack.length > 0 && (
            <div class="mt-3 flex flex-wrap gap-2">
              {exp.data.stack.map((s) => (
                <span class="rounded bg-slate-100 px-2 py-0.5 text-xs text-slate-500">{s}</span>
              ))}
            </div>
          )}
        </li>
      ))}
    </ol>
  </div>
</section>
